# infra/k8s/base/secrets/backend.env.example
# ──────────────────────────────────────────────────────────────────────────────
# Template for the backend-secret. COPY to `backend.env`, fill in REAL values,
# then seal it. NEVER commit backend.env — only the sealed output is safe.
#
# Seal + apply + reload (run from repo root):
#   cp infra/k8s/base/secrets/backend.env.example backend.env   # then edit it
#   kubectl create secret generic backend-secret --from-env-file=backend.env \
#     --namespace aivestire --dry-run=client -o yaml \
#     | kubeseal --format yaml --namespace aivestire \
#     > ~/aivestire-sealed-secrets-private/backend-sealed-secret.yaml
#   kubectl apply -f ~/aivestire-sealed-secrets-private/backend-sealed-secret.yaml
#   kubectl -n aivestire rollout restart deploy/backend deploy/backend-worker
#   rm backend.env        # delete the plaintext when done (keep it in a vault, not git)
#
# Only the 4 PAYU_* keys are STRICTLY REQUIRED (app crashes without them).
# For everything else: a real value enables the feature; a placeholder leaves it
# disabled but the app still boots.
# ──────────────────────────────────────────────────────────────────────────────

# ── Core (required) ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aivestire:CHANGE_ME_PG_PASSWORD@postgres:5432/aivestire
JWT_SECRET=CHANGE_ME_64_HEX                 # openssl rand -hex 32
JWT_EXPIRATION_TIME=24h
JWT_REFRESH_EXPIRATION_TIME=7d
ADMIN_JWT_SECRET=CHANGE_ME_64_HEX           # openssl rand -hex 32
ADMIN_SECRET=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD     # must match redis-secret

# ── PayU (REQUIRED — these 4 or the app won't start) ──────────────────────────
PAYU_KEY=your-payu-merchant-key
PAYU_SALT=your-payu-merchant-salt
PAYU_SUCCESS_URL=https://your-domain/payment/success
PAYU_FAILURE_URL=https://your-domain/payment/failure

# ── Razorpay (optional) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Cloudinary — media uploads (optional) ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google OAuth — login (optional) ───────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Twilio SMS (optional) — also set SKIP_TWILIO=false on the deployment ──────
TWILIO_ACCOUNT_SID=                          # MUST start with "AC" or Nest crashes
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── SMTP email (optional) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                                    # note: SMTP_PASS, not SMTP_PASSWORD

# ── AI / try-on (optional) ────────────────────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=             # base64 of the Vertex SA json, if used

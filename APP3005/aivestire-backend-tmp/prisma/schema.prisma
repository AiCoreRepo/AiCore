generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



enum AuraStatus {
  PENDING   // AI generation started
  READY     // AI finished (5 avatars available)
  ERROR     // AI failed or Cloudinary failed
}

enum UserRole {
  BUYER
  CREATOR
  ADMIN
}

enum ProductStatus{
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum ApprovalStatus{
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

model User {
  user_id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String   @unique
  password_hash      String?
  phone              String?
  refresh_token_hash String?
  role UserRole @default(BUYER)
  status             String   @default("active")
  
  // Try-on tracking (simple approach)
  try_ons_used       Int      @default(0)      // How many try-ons used
  max_try_ons        Int      @default(10)     // Free limit
  
  created_at         DateTime @default(now())
  last_login         DateTime?

  creatorProfile     Creator?
  approvals_submitted ProductApproval[] @relation("SubmittedBy")
  approvals_actioned  ProductApproval[] @relation("ActionedBy")
  aura                Aura?
  product_likes       ProductLike[]
  product_comments    ProductComment[]
  try_on_history      TryOn[]
}

model Creator {
  creator_id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @unique @db.Uuid
  store_name   String
  store_slug   String   @unique
  about        String?
  verified     Boolean  @default(false)
  verification_data Json?
  
  // Terms & Conditions tracking
  terms_accepted    Boolean   @default(false)
  terms_accepted_at DateTime?
  terms_version     String?
  
  created_at   DateTime @default(now())

  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  limits       CreatorLimit?
  products     Product[]
}

model CreatorLimit {
  creator_id             String @id @db.Uuid
  max_products           Int    @default(100)
  max_images_per_product Int    @default(20)
  created_at             DateTime @default(now())

  creator Creator @relation(fields: [creator_id], references: [creator_id])
}

model Product {
  product_id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creator_id      String  @db.Uuid
  title           String
  slug            String   @unique
  description     String?
  price_cents     Int
  currency        String   @default("INR")
  inventory_count Int      @default(0)
  category        String?  // Product category (Dress, Top, Bottom, etc.)
  is_featured     Boolean  @default(false) // Featured on homepage
  status          ProductStatus @default(PENDING)
  is_deleted      Boolean  @default(false)
  max_images      Int      @default(20)
  
  // Recommendation system metadata
  metadata        Json?    // Stores recommendation attributes: occasions, body_shapes, skin_tones, sizes, fit, fabric, color_family, style
  
  created_at      DateTime @default(now())
  updated_at      DateTime?

  creator         Creator  @relation(fields: [creator_id], references: [creator_id])
  images          ProductImage[]
  approvals       ProductApproval[]
  stats           ProductStat?
  likes           ProductLike[]
  comments        ProductComment[]
  try_ons         TryOn[]
}

model ProductImage {
  image_id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id   String  @db.Uuid
  url          String
  order_index  Int     @default(0)
  is_primary   Boolean @default(false)
  uploaded_at  DateTime @default(now())

  product      Product @relation(fields: [product_id], references: [product_id])
}

model ProductApproval {
  approval_id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id     String   @db.Uuid
  submitted_by   String?  @db.Uuid // user.user_id
  admin_user_id  String?  @db.Uuid // user.user_id
  status         ApprovalStatus @default(PENDING)
  comment        String?
  created_at     DateTime @default(now())
  actioned_at    DateTime?

  product        Product @relation(fields: [product_id], references: [product_id])
  submittedBy    User?   @relation("SubmittedBy", fields: [submitted_by], references: [user_id])
  actionedBy     User?   @relation("ActionedBy", fields: [admin_user_id], references: [user_id])
  logs           ApprovalLog[]
}

model ApprovalLog {
  log_id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approval_id    String  @db.Uuid
  actor_user_id  String? @db.Uuid
  action         String
  comment        String?
  created_at     DateTime @default(now())

  approval       ProductApproval @relation(fields: [approval_id], references: [approval_id])
}

model ProductStat {
  product_id      String  @id @db.Uuid
  views           Int     @default(0)
  likes_count     Int     @default(0)
  comments_count  Int     @default(0)
  last_updated    DateTime?

  product         Product @relation(fields: [product_id], references: [product_id])
}

model ProductLike {
  like_id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id   String   @db.Uuid
  user_id      String   @db.Uuid
  created_at   DateTime @default(now())
  
  product      Product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  
  @@unique([product_id, user_id])
  @@map("product_likes")
}

model ProductComment {
  comment_id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id   String   @db.Uuid
  user_id      String   @db.Uuid
  comment_text String   @db.Text
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  
  product      Product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  
  @@map("product_comments")
}

model Aura {
  aura_id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String        @unique @db.Uuid

  // User uploaded full-body image (Cloudinary)
  image_url             String?

  // User-provided attributes
  height_cm             Int?
  weight_kg             Int?
  skin_tone             String?
  gender                String?
  body_shape            String?
  age_range             String?
  hair_style            String?
  beard                 Boolean?

  // Flexible extra data for AI (input or other preferences)
  extra_attributes      Json?

  // ML output: prefer a single model_url (per your senior),
  // keep generated_avatar_urls as fallback if ML returns multiples
  model_url             String?       // single model (3D render / final image)
  generated_avatar_urls String[]      @default([]) // optional array if ML returns many

  // Final merged attributes / extracted attributes returned by ML
  attributes            Json?         // holds ML returned attributes (height, skin tone, confidence, etc)

  // PENDING → worker generating
  // READY → model_url (or generated_avatar_urls) available
  // ERROR → failed
  status                AuraStatus    @default(PENDING)

  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  user                  User          @relation(fields: [user_id], references: [user_id])
  try_ons               TryOn[]

  @@index([status])
}

// Simple try-on tracking
model TryOn {
  try_on_id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @db.Uuid
  product_id       String   @db.Uuid
  aura_id          String   @db.Uuid
  result_image_url String   // AI generated try-on result
  created_at       DateTime @default(now())
  
  user             User     @relation(fields: [user_id], references: [user_id])
  product          Product  @relation(fields: [product_id], references: [product_id])
  aura             Aura     @relation(fields: [aura_id], references: [aura_id])
  
  @@index([user_id])
  @@map("try_ons")
}

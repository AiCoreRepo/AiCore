generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                     String                @unique
  password_hash             String?
  date_of_birth             DateTime?
  phone                     String?
  phone_verified            Boolean               @default(false)
  status                    String                @default("active")
  try_on_permission         TryOnPermissionStatus @default(NONE)
  created_at                DateTime              @default(now())
  last_login                DateTime?
  refresh_token_hash        String?
  role                      UserRole              @default(BUYER)
  max_try_ons               Int                   @default(3)
  try_ons_used              Int                   @default(0)
  has_created_aura          Boolean               @default(false)
  max_avatar_regenerations  Int                   @default(2)
  avatar_regenerations_used Int                   @default(0)
  aura                      Aura?
  creatorProfile            Creator?
  approvals_actioned        ProductApproval[]     @relation("ActionedBy")
  approvals_submitted       ProductApproval[]     @relation("SubmittedBy")
  product_comments          ProductComment[]
  product_likes             ProductLike[]
  try_on_history            TryOn[]
  feedbacks                 Feedback[]
  cart                      Cart?
  addresses                 UserAddress[]
  wishlist                  Wishlist?
  orders                    Order[]
  wallet                    Wallet?
}

model Creator {
  creator_id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String          @unique @db.Uuid
  store_name        String
  store_slug        String          @unique
  about             String?
  verified          Boolean         @default(false)
  verification_data Json?
  created_at        DateTime        @default(now())
  terms_accepted    Boolean         @default(false)
  terms_accepted_at DateTime?
  terms_version     String?
  user              User            @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  limits            CreatorLimit?
  products          Product[]
  creator_coupons   CreatorCoupon[]
  product_groups    ProductGroup[]
  order_items       OrderItem[]
  payouts           Payout[]
  address           CreatorAddress?
}

// ============================================
// CREATOR ADDRESS (business/payout contact)
// Separate from UserAddress (buyer shipping)
// ============================================

model CreatorAddress {
  address_id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creator_id    String   @unique @db.Uuid
  full_name     String
  phone         String
  address_line1 String
  address_line2 String?
  city          String
  state         String
  pincode       String
  country       String   @default("India")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  creator Creator @relation(fields: [creator_id], references: [creator_id], onDelete: Cascade)

  // @unique on creator_id already creates an implicit index in Postgres.
  // No additional @@index needed — avoids redundant over-indexing.
  @@map("creator_addresses")
}

model CreatorLimit {
  creator_id             String   @id @db.Uuid
  max_products           Int      @default(30)
  max_images_per_product Int      @default(20)
  created_at             DateTime @default(now())
  creator                Creator  @relation(fields: [creator_id], references: [creator_id])
}

model Product {
  product_id        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creator_id        String                   @db.Uuid
  title             String
  slug              String                   @unique
  description       String?
  price_cents       Int
  commission_percentage Int                  @default(10)
  currency          String                   @default("INR")
  inventory_count   Int                      @default(0)
  is_deleted        Boolean                  @default(false)
  max_images        Int                      @default(20)
  metadata          Json? // Recommendation attributes
  created_at        DateTime                 @default(now())
  updated_at        DateTime?
  status            ProductStatus            @default(DRAFT)
  category          String?
  category_id       String?                  @db.Uuid
  sub_category_id   String?                  @db.Uuid
  is_featured       Boolean                  @default(false)
  stock_label_override String?               // Admin override: 'LOW' | 'OK' | 'HIGH' | null (auto-computed)
  // Recommendation attribute columns
  occasions         String[]                 @default([])
  body_shapes       String[]                 @default([])
  skin_tones        String[]                 @default([])
  sizes             String[]                 @default([])
  age_ranges        String[]                 @default([])
  creator           Creator                  @relation(fields: [creator_id], references: [creator_id])
  approvals         ProductApproval[]
  images            ProductImage[]
  patterns          ProductPattern[]
  stats             ProductStat?
  comments          ProductComment[]
  likes             ProductLike[]
  try_ons           TryOn[]
  cart_items        CartItem[]
  guest_cart_items  GuestCartItem[]
  wishlist_items    WishlistItem[]
  order_items       OrderItem[]
  creator_coupons   CreatorCoupon[]
  group_assignments ProductGroupAssignment[]
  category_rel      Category?                @relation(fields: [category_id], references: [category_id])
  sub_category_rel  SubCategory?             @relation(fields: [sub_category_id], references: [sub_category_id])
}

// ============================================
// CREATOR UPLOAD HIERARCHY
// Product → Pattern (Body Shape) → Color Variant (Skin Tone + Stock + Images)
// ============================================

model ProductPattern {
  pattern_id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id   String   @db.Uuid
  name         String   // e.g. "Slim Fit", "Relaxed Fit"
  body_shapes  BodyShape[] // which body shapes this pattern suits
  display_order Int     @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  product       Product              @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  color_variants ProductColorVariant[]

  @@index([product_id])
  @@map("product_patterns")
}

model ProductColorVariant {
  variant_id    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pattern_id    String     @db.Uuid
  color         ClothingColor
  hex_code      String?    // Optional custom hex for display
  stock         Int        @default(0)
  skin_tones    SkinTone[] // which skin tones this color suits
  display_order Int        @default(0)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  pattern ProductPattern          @relation(fields: [pattern_id], references: [pattern_id], onDelete: Cascade)
  images  ProductColorVariantImage[]

  @@index([pattern_id])
  @@map("product_color_variants")
}

model ProductColorVariantImage {
  image_id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  variant_id    String   @db.Uuid
  url           String
  order_index   Int      @default(0)
  is_primary    Boolean  @default(false)
  uploaded_at   DateTime @default(now())

  variant ProductColorVariant @relation(fields: [variant_id], references: [variant_id], onDelete: Cascade)

  @@index([variant_id])
  @@map("product_color_variant_images")
}

model ProductGroup {
  group_id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creator_id  String   @db.Uuid
  name        String
  slug        String
  description String?
  parent_id   String?  @db.Uuid
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  parent   ProductGroup?            @relation("GroupHierarchy", fields: [parent_id], references: [group_id])
  children ProductGroup[]           @relation("GroupHierarchy")
  creator  Creator                  @relation(fields: [creator_id], references: [creator_id], onDelete: Cascade)
  products ProductGroupAssignment[]

  @@unique([creator_id, slug])
  @@index([creator_id])
  @@index([parent_id])
  @@map("product_groups")
}

model ProductGroupAssignment {
  assignment_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id    String   @db.Uuid
  group_id      String   @db.Uuid
  assigned_at   DateTime @default(now())

  product Product      @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  group   ProductGroup @relation(fields: [group_id], references: [group_id], onDelete: Cascade)

  @@unique([product_id, group_id])
  @@index([group_id])
  @@index([product_id])
  @@map("product_group_assignments")
}

// ============================================
// CATEGORIES & SUBCATEGORIES
// ============================================

model Category {
  category_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  subcategories SubCategory[]
  products      Product[]

  @@map("categories")
}

model SubCategory {
  sub_category_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id     String   @db.Uuid
  name            String
  slug            String   @unique
  description     String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  category Category  @relation(fields: [category_id], references: [category_id], onDelete: Cascade)
  products Product[]

  @@unique([category_id, name])
  @@index([category_id])
  @@map("sub_categories")
}

// ============================================
// ENTERPRISE CART SYSTEM
// ============================================

// Guest Cart - Session-based cart for unauthenticated users
model GuestCart {
  guest_cart_id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id          String          @unique // Cookie-based guest session
  region              String          @default("IN")
  channel             String          @default("WEB") // WEB, ANDROID, IOS
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  expires_at          DateTime // Auto-expire inactive guest carts
  applied_coupon_code String?
  items               GuestCartItem[]

  @@index([session_id])
  @@index([expires_at])
  @@map("guest_carts")
}

model GuestCartItem {
  guest_cart_item_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  guest_cart_id        String    @db.Uuid
  product_id           String    @db.Uuid
  quantity             Int       @default(1)
  size                 String?
  color                String?
  price_cents_snapshot Int
  currency_snapshot    String    @default("INR")
  added_at             DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  guest_cart           GuestCart @relation(fields: [guest_cart_id], references: [guest_cart_id], onDelete: Cascade)
  product              Product   @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@unique([guest_cart_id, product_id, size, color])
  @@index([guest_cart_id])
  @@index([product_id])
  @@map("guest_cart_items")
}

// User Cart - Persisted cart for authenticated users
model Cart {
  cart_id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String     @unique @db.Uuid
  version             Int        @default(1) // Optimistic locking for race conditions
  merged_from_guest   Boolean    @default(false) // Idempotency guard for merge
  region              String     @default("IN")
  channel             String     @default("WEB")
  applied_coupon_code String?
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt
  user                User       @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  items               CartItem[]

  @@index([user_id])
  @@map("carts")
}

model CartItem {
  cart_item_id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cart_id              String   @db.Uuid
  product_id           String   @db.Uuid
  quantity             Int      @default(1)
  size                 String?
  color                String?
  price_cents_snapshot Int // Price at time of adding
  currency_snapshot    String   @default("INR")
  added_at             DateTime @default(now())
  updated_at           DateTime @updatedAt
  cart                 Cart     @relation(fields: [cart_id], references: [cart_id], onDelete: Cascade)
  product              Product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@unique([cart_id, product_id, size, color])
  @@index([cart_id])
  @@index([product_id])
  @@map("cart_items")
}

model Wishlist {
  wishlist_id String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String         @unique @db.Uuid
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt
  user        User           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  items       WishlistItem[]

  @@index([user_id])
  @@map("wishlists")
}

model WishlistItem {
  wishlist_item_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wishlist_id      String   @db.Uuid
  product_id       String   @db.Uuid
  added_at         DateTime @default(now())
  wishlist         Wishlist @relation(fields: [wishlist_id], references: [wishlist_id], onDelete: Cascade)
  product          Product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@unique([wishlist_id, product_id])
  @@index([wishlist_id])
  @@index([product_id])
  @@map("wishlist_items")
}

model ProductImage {
  image_id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id  String   @db.Uuid
  url         String
  order_index Int      @default(0)
  is_primary  Boolean  @default(false)
  uploaded_at DateTime @default(now())
  product     Product  @relation(fields: [product_id], references: [product_id])
}

model ProductApproval {
  approval_id   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id    String         @db.Uuid
  submitted_by  String?        @db.Uuid
  admin_user_id String?        @db.Uuid
  comment       String?
  created_at    DateTime       @default(now())
  actioned_at   DateTime?
  status        ApprovalStatus @default(PENDING)
  logs          ApprovalLog[]
  actionedBy    User?          @relation("ActionedBy", fields: [admin_user_id], references: [user_id])
  product       Product        @relation(fields: [product_id], references: [product_id])
  submittedBy   User?          @relation("SubmittedBy", fields: [submitted_by], references: [user_id])
}

model ApprovalLog {
  log_id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  approval_id   String          @db.Uuid
  actor_user_id String?         @db.Uuid
  action        String
  comment       String?
  created_at    DateTime        @default(now())
  approval      ProductApproval @relation(fields: [approval_id], references: [approval_id])
}

model ProductStat {
  product_id     String    @id @db.Uuid
  views          Int       @default(0)
  likes_count    Int       @default(0)
  comments_count Int       @default(0)
  last_updated   DateTime?
  product        Product   @relation(fields: [product_id], references: [product_id])
}

model ProductLike {
  like_id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id String   @db.Uuid
  user_id    String   @db.Uuid
  created_at DateTime @default(now())
  product    Product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  user       User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([product_id, user_id])
  @@map("product_likes")
}

model ProductComment {
  comment_id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id   String   @db.Uuid
  user_id      String   @db.Uuid
  comment_text String
  image_urls   String[] @default([])
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  product      Product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade)
  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("product_comments")
}

model Aura {
  aura_id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String     @unique @db.Uuid
  image_url             String?
  height_cm             Int?
  weight_kg             Int?
  skin_tone             String?
  gender                String?
  body_shape            String?
  body_type             String?
  body_size             String?
  age_range             String?
  hair_style            String?
  beard                 Boolean?
  extra_attributes      Json?
  model_url             String?
  tryon_model_url       String?
  generated_avatar_urls String[]   @default([])
  attributes            Json?
  status                AuraStatus @default(PENDING)
  created_at            DateTime   @default(now())
  updated_at            DateTime   @updatedAt
  user                  User       @relation(fields: [user_id], references: [user_id])
  try_ons               TryOn[]

  @@index([status])
}

enum FeedbackContextType {
  AVATAR_CREATION
  AVATAR_RECREATION
  VIRTUAL_TRYON
}

model Feedback {
  feedback_id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String              @db.Uuid
  context_type         FeedbackContextType
  context_reference_id String?
  context_label        String?
  rating               Int
  comment              String?
  metadata             Json?
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt
  user                 User                @relation(fields: [user_id], references: [user_id])

  @@index([user_id, created_at])
  @@index([context_type, rating, created_at])
}

model TryOn {
  try_on_id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @db.Uuid
  product_id       String   @db.Uuid
  aura_id          String   @db.Uuid
  result_image_url String
  created_at       DateTime @default(now())
  provider         String   @default("unknown")
  angle            String?
  base_tryon_id    String?  @db.Uuid

  // Caching & Optimization fields
  cloudinary_public_id String? // Cloudinary public ID for transformations
  thumbnail_url        String? // Compressed thumbnail URL
  compressed_url       String? // Compressed version URL
  metadata_cache       Json? // Cached metadata (colors, dimensions, etc.)
  processing_metrics   Json? // Token usage, processing time, compression ratio
  angles_generated     String[] @default([]) // Track which angles have been generated

  aura          Aura    @relation(fields: [aura_id], references: [aura_id])
  try_ons       TryOn?  @relation("try_onsTotry_ons", fields: [base_tryon_id], references: [try_on_id])
  other_try_ons TryOn[] @relation("try_onsTotry_ons")
  product       Product @relation(fields: [product_id], references: [product_id])
  user          User    @relation(fields: [user_id], references: [user_id])

  @@index([user_id])
  @@index([aura_id, product_id, angle])
  @@index([cloudinary_public_id])
  @@map("try_ons")
}

model OtpVerification {
  otp_id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone_number String
  otp_hash     String // Hashed OTP for security
  expires_at   DateTime
  verified     Boolean  @default(false)
  attempts     Int      @default(0)
  created_at   DateTime @default(now())

  @@index([phone_number])
  @@index([expires_at])
  @@map("otp_verifications")
}

enum AuraStatus {
  PENDING
  READY
  ERROR
}

enum UserRole {
  BUYER
  CREATOR
  ADMIN
}

enum ProductStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum TryOnPermissionStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum AddressType {
  HOME
  WORK
  OTHER
}

// ============================================
// CREATOR UPLOAD ENUMS
// ============================================

enum BodyShape {
  HOURGLASS
  PEAR
  APPLE
  RECTANGLE
  INVERTED_TRIANGLE
  OVAL
  ATHLETIC
  PETITE
  PLUS_SIZE
}

enum SkinTone {
  FAIR
  LIGHT
  MEDIUM
  OLIVE
  TAN
  BROWN
  DARK_BROWN
  DEEP
}

enum ClothingColor {
  BLACK
  WHITE
  GREY
  CHARCOAL
  NAVY
  ROYAL_BLUE
  SKY_BLUE
  TEAL
  GREEN
  OLIVE_GREEN
  MINT
  RED
  MAROON
  PINK
  HOT_PINK
  CORAL
  ORANGE
  YELLOW
  GOLD
  BEIGE
  CREAM
  BROWN
  CHOCOLATE
  CARAMEL
  LAVENDER
  PURPLE
  INDIGO
  RUST
  OFF_WHITE
  MULTI_COLOR
  PRINTED
  OTHER
}

model UserAddress {
  address_id    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String      @db.Uuid
  full_name     String
  phone         String
  pincode       String
  address_line1 String // House No, Building, Street
  address_line2 String? // Locality, Area
  city          String
  state         String
  landmark      String?
  address_type  AddressType @default(HOME)
  is_default    Boolean     @default(false)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  user          User        @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  orders        Order[]

  @@index([user_id])
  @@map("user_addresses")
}

// ============================================
// ORDER STATES & TRACKING SYSTEM
// ============================================

model Order {
  order_id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number String @unique
  user_id      String @db.Uuid

  // Order Details
  total_amount   Decimal       @db.Decimal(10, 2)
  payment_method PaymentMethod
  payment_status PaymentStatus @default(PENDING)

  // Current State
  current_status OrderStatus @default(PENDING)
  inventory_deducted Boolean @default(false)

  // COD Specific
  cod_collected    Boolean   @default(false)
  cod_collected_at DateTime?
  cod_collected_by String?   @db.Uuid

  // Shipping Address
  shipping_address_id String @db.Uuid

  // Tracking
  tracking_number         String?
  delivery_partner        String?
  estimated_delivery_date DateTime?

  // Cancellation
  cancelled_at        DateTime?
  cancelled_by        String?   @db.Uuid
  cancellation_reason String?
  cancel_feedback     String?

  // Refund Tracking
  refund_status RefundStatus?
  refund_amount Decimal?      @db.Decimal(10, 2)

  // Return Tracking
  return_status       ReturnStatus?
  return_requested_at DateTime?

  // Replacement Tracking
  replace_status       ReplacementStatus?
  replace_requested_at DateTime?

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relations
  user                 User                 @relation(fields: [user_id], references: [user_id])
  shipping_address     UserAddress          @relation(fields: [shipping_address_id], references: [address_id])
  items                OrderItem[]
  status_history       OrderStatusHistory[]
  delivery_tracking    DeliveryTracking[]
  refunds              OrderRefund[]
  returns              OrderReturn[]
  replacements         OrderReplacement[]
  payment_transactions PaymentTransaction[]

  @@index([user_id])
  @@index([current_status])
  @@index([order_number])
  @@index([tracking_number])
  @@index([created_at(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  order_item_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id      String @db.Uuid
  product_id    String @db.Uuid

  // Item Details
  quantity    Int
  unit_price  Decimal @db.Decimal(10, 2)
  total_price Decimal @db.Decimal(10, 2)

  // Snapshot data (in case product deleted)
  product_name    String
  product_image   String?
  variant_details Json?
  size            String?
  color           String?

  // Financial Snapshot data
  creator_id    String      @db.Uuid
  creator_price Decimal     @db.Decimal(10, 2)
  commission    Decimal     @db.Decimal(10, 2)
  selling_price Decimal     @db.Decimal(10, 2)
  order_status  OrderStatus @default(PENDING)
  delivered_at  DateTime?

  created_at DateTime @default(now())

  // Relations
  order   Order   @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [product_id])
  creator Creator @relation(fields: [creator_id], references: [creator_id])

  @@index([order_id])
  @@index([product_id])
  @@index([creator_id])
  @@index([order_status])
  @@index([delivered_at])
  @@index([creator_id, order_status])
  @@index([creator_id, delivered_at])
  @@map("order_items")
}

model OrderStatusHistory {
  history_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id   String @db.Uuid

  // Status Change
  from_status String?
  to_status   String

  // Metadata
  changed_by      String?        @db.Uuid
  changed_by_type ChangedByType?

  // Additional Info
  notes    String?
  metadata Json?

  // Timestamp (immutable)
  created_at DateTime @default(now())

  // Relations
  order Order @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@index([order_id])
  @@index([created_at(sort: Desc)])
  @@map("order_status_history")
}

model DeliveryTracking {
  tracking_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id    String @db.Uuid

  // Location Data
  location_name String
  location_type LocationType

  // Coordinates
  latitude  Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)

  // Details
  status_description     String
  delivery_partner_agent String?

  // Metadata
  metadata Json?

  // Timestamp (immutable)
  created_at DateTime @default(now())

  // Relations
  order Order @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@index([order_id])
  @@index([created_at(sort: Desc)])
  @@map("delivery_tracking")
}

// ============================================
// REFUND SYSTEM
// ============================================

model OrderRefund {
  refund_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id  String @db.Uuid

  // Refund Details
  amount        Decimal      @db.Decimal(10, 2)
  refund_status RefundStatus @default(PENDING_REVIEW)
  refund_reason String?

  // Admin Review Audit
  reviewed_by   String?   @db.Uuid
  reviewed_at   DateTime?
  review_notes  String?

  // Approval (kept for backwards compat)
  approved_by      String?   @db.Uuid
  approved_at      DateTime?
  rejection_reason String?

  // Archive tracking
  archived_at DateTime?
  archived_by String?   @db.Uuid

  // Processing
  refund_method  String? // Bank transfer, original payment method, etc.
  transaction_id String? // Transaction ref from payment gateway

  // PayU Refund Tracking
  payu_refund_id String? // PayU refund transaction ID
  payu_response  Json?   // Full PayU API response for debugging / finance audit

  // Timestamps
  initiated_at  DateTime  @default(now())
  processing_at DateTime?
  completed_at  DateTime?
  failed_at     DateTime?

  // Notes
  notes    String?
  metadata Json?

  // Relations
  order Order @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@index([order_id])
  @@index([refund_status])
  @@index([initiated_at(sort: Desc)])
  @@map("order_refunds")
}

// ============================================
// RETURN SYSTEM
// ============================================

model OrderReturn {
  return_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id  String @db.Uuid

  // Return Request
  return_reason ReturnReason
  custom_reason String?
  feedback      String?

  // Status
  return_status ReturnStatus @default(REQUESTED)

  // Approval/Rejection
  approved_by      String?   @db.Uuid
  approved_at      DateTime?
  rejected_by      String?   @db.Uuid
  rejected_at      DateTime?
  rejection_reason String?

  // Pickup Details
  pickup_scheduled DateTime?
  pickup_partner   String?
  pickup_tracking  String?
  picked_up_at     DateTime?

  // Quality Check
  qc_passed       Boolean?
  qc_notes        String?
  qc_completed_at DateTime?

  // Refund (if applicable)
  refund_id String? @db.Uuid

  // Timestamps
  requested_at DateTime  @default(now())
  completed_at DateTime?

  // Notes
  notes    String?
  metadata Json?

  // Relations
  order Order @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@index([order_id])
  @@index([return_status])
  @@index([requested_at(sort: Desc)])
  @@map("order_returns")
}

// ============================================
// REPLACEMENT SYSTEM
// ============================================

model OrderReplacement {
  replacement_id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  original_order_id String  @db.Uuid
  new_order_id      String? @db.Uuid

  // Replacement Request
  replace_reason ReplaceReason
  custom_reason  String?
  feedback       String?

  // Status
  replacement_status ReplacementStatus @default(REQUESTED)

  // Approval/Rejection
  approved_by      String?   @db.Uuid
  approved_at      DateTime?
  rejected_by      String?   @db.Uuid
  rejected_at      DateTime?
  rejection_reason String?

  // Pickup Details (for original item)
  pickup_scheduled DateTime?
  pickup_partner   String?
  pickup_tracking  String?
  picked_up_at     DateTime?

  // Delivery Details (for replacement)
  dispatched_at     DateTime?
  delivery_tracking String?
  delivered_at      DateTime?

  // Timestamps
  requested_at DateTime  @default(now())
  completed_at DateTime?

  // Notes
  notes    String?
  metadata Json?

  // Relations
  original_order Order @relation(fields: [original_order_id], references: [order_id], onDelete: Cascade)

  @@index([original_order_id])
  @@index([new_order_id])
  @@index([replacement_status])
  @@index([requested_at(sort: Desc)])
  @@map("order_replacements")
}


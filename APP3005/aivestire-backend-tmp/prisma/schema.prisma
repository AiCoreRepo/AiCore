// ============================================
// PAYMENT GATEWAY SYSTEM
// ============================================

/**
 * Tracks every PayU transaction attempt for an order.
 * One order can have multiple attempts (e.g., user retries after failure).
 */
model PaymentTransaction {
  transaction_id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id       String @db.Uuid

  // Gateway Info
  gateway            PaymentGateway @default(PAYU)
  gateway_order_id   String?        @unique // PayU txnid
  gateway_payment_id String? // PayU mihpayid

  // Amount
  amount_paise Int // Amount in paise (smallest unit)
  currency     String  @default("INR")
  receipt      String? // Unique txnid sent to PayU

  // Status
  status         PaymentTransactionStatus @default(CREATED)
  payment_method String? // card, upi, netbanking, wallet, etc.

  // Refund
  refund_id   String? // PayU refund ID
  refunded_at DateTime?

  // Timestamps
  created_at  DateTime  @default(now())
  captured_at DateTime?
  updated_at  DateTime  @updatedAt

  // Metadata (raw PayU postback response)
  metadata Json?

  // Relations
  order Order @relation(fields: [order_id], references: [order_id], onDelete: Cascade)

  @@index([order_id])
  @@index([gateway_order_id])
  @@index([gateway_payment_id])
  @@index([status])
  @@index([created_at(sort: Desc)])
  @@map("payment_transactions")
}

enum PaymentGateway {
  PAYU
  COD
}

enum PaymentTransactionStatus {
  CREATED
  ATTEMPTED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

// ============================================
// COUPON SYSTEM
// ============================================

enum CouponType {
  FLAT
  PERCENTAGE
  DELIVERY
}

enum CouponStatus {
  ACTIVE
  DISABLED
  EXPIRED
}

enum CouponScopeType {
  GLOBAL
  PRICE_LEVEL
  FESTIVAL
  USER
  COMPANY_SPECIAL
  COLLECTION
  USER_BIRTHDAY
  COMPANY_ANNIVERSARY
}

enum CouponApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

model Coupon {
  coupon_id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  code        String  @unique
  description String?

  // Discount
  discount_type    CouponType
  discount_value   Decimal    @db.Decimal(10, 2)
  min_order_amount Decimal    @default(0) @db.Decimal(10, 2)

  // Usage
  max_usage     Int @default(1)
  current_usage Int @default(0)

  // Status & Reason
  status CouponStatus @default(ACTIVE)
  reason String? // e.g., festival, event, offer

  // Terms
  terms_and_conditions String?

  // Validity
  start_date DateTime
  end_date   DateTime

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Location restriction
  is_location_restricted Boolean @default(false)

  // Production-ready flags
  is_one_time_per_user Boolean @default(false)
  is_stackable         Boolean @default(false)
  is_deleted           Boolean @default(false)

  // Relations
  allowed_pincodes CouponAllowedPincode[]
  scope            CouponScope?

  @@index([status])
  @@index([code])
  @@index([reason])
  @@index([start_date])
  @@index([end_date])
  @@index([is_deleted])
  @@map("coupons")
}

model CouponAllowedPincode {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coupon_id String @db.Uuid
  pincode   String

  coupon Coupon @relation(fields: [coupon_id], references: [coupon_id], onDelete: Cascade)

  @@unique([coupon_id, pincode])
  @@index([coupon_id])
  @@index([pincode])
  @@map("coupon_allowed_pincodes")
}

model CouponScope {
  scope_id  String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coupon_id String @unique @db.Uuid

  scope_type CouponScopeType @default(GLOBAL)

  // PRICE_LEVEL fields
  min_price Decimal? @db.Decimal(10, 2)
  max_price Decimal? @db.Decimal(10, 2)

  // FESTIVAL field
  festival_key String? // e.g. "DIWALI", "HOLI" — maps to hardcoded constants

  // COMPANY_ANNIVERSARY field
  company_anniversary_date DateTime? // The company anniversary date

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  coupon Coupon @relation(fields: [coupon_id], references: [coupon_id], onDelete: Cascade)

  @@index([scope_type])
  @@index([coupon_id])
  @@map("coupon_scopes")
}

// ============================================
// CREATOR COUPONS
// ============================================

model CreatorCoupon {
  creator_coupon_id String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String
  code              String  @unique
  description       String?

  // Discount
  discount_type    CouponType
  discount_value   Decimal    @db.Decimal(10, 2)
  min_order_amount Decimal    @default(0) @db.Decimal(10, 2)

  // Usage
  max_usage     Int @default(1)
  current_usage Int @default(0)

  // Status & Approval
  status          CouponStatus         @default(ACTIVE)
  approval_status CouponApprovalStatus @default(PENDING)
  approval_note   String?

  // Validity
  start_date DateTime
  end_date   DateTime

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Production-ready flags
  is_deleted Boolean @default(false)

  // Relations
  creator_id String  @db.Uuid
  product_id String  @db.Uuid
  creator    Creator @relation(fields: [creator_id], references: [creator_id], onDelete: Cascade)
  product    Product @relation(fields: [product_id], references: [product_id], onDelete: Cascade)

  @@index([status])
  @@index([code])
  @@index([start_date])
  @@index([end_date])
  @@index([is_deleted])
  @@index([creator_id])
  @@index([product_id])
  @@index([approval_status])
  @@map("creator_coupons")
}

// ============================================
// WALLET SYSTEM
// ============================================

model Wallet {
  wallet_id  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @unique @db.Uuid
  balance    Decimal  @default(0) @db.Decimal(10, 2)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user         User                @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@index([user_id])
  @@map("wallets")
}

model WalletTransaction {
  transaction_id String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wallet_id      String                  @db.Uuid
  type           WalletTransactionType
  source         WalletTransactionSource
  amount         Decimal                 @db.Decimal(10, 2)
  reference_id   String?
  description    String?
  status         WalletTransactionStatus @default(SUCCESS)
  created_at     DateTime                @default(now())

  wallet Wallet @relation(fields: [wallet_id], references: [wallet_id], onDelete: Cascade)

  @@index([wallet_id])
  @@index([type])
  @@index([source])
  @@index([created_at(sort: Desc)])
  @@map("wallet_transactions")
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionSource {
  REFUND
  CASHBACK
  ORDER_PAYMENT
  ADMIN_CREDIT
  PROMOTION
}

enum WalletTransactionStatus {
  SUCCESS
  FAILED
  REVERSED
}

// ============================================
// PAYOUT SYSTEM
// ============================================

enum PayoutStatus {
  PENDING     // Row created, awaiting dispatch
  PROCESSING  // Request sent to PayU
  SUCCESS     // Gateway confirmed transfer
  FAILED      // Gateway rejected transfer
  CANCELLED   // Admin cancelled before dispatch
}

enum PayoutType {
  FULL
  PARTIAL
}

model Payout {
  payout_id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creator_id         String       @db.Uuid
  amount             Decimal      @db.Decimal(10, 2)
  payout_type        PayoutType   @default(FULL)
  status             PayoutStatus @default(PENDING)

  // Gateway fields
  gateway_status     String?      // Raw PayU status string (success / failed / pending)
  transaction_id     String?      // PayU transfer_id / mihpayid
  payment_gateway    String       @default("PAYU")

  // UPI / beneficiary details
  upi_id             String?
  phone_number       String?

  // Audit
  processed_by_admin String?      @db.Uuid // admin user_id (no FK to keep User model clean)

  // Timestamps
  initiated_at       DateTime     @default(now())
  completed_at       DateTime?
  failed_at          DateTime?
  failure_reason     String?
  note               String?
  created_at         DateTime     @default(now())

  creator Creator @relation(fields: [creator_id], references: [creator_id])

  @@index([creator_id])
  @@index([status])
  @@index([creator_id, status])
  @@index([transaction_id])
  @@map("payouts")
}
